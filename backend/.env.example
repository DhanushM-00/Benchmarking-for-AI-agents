# Copy to backend/.env and fill in values. Never commit backend/.env.

# Execution mode: auto | live | simulated
BIFROST_MODE=auto

# Maxim AI Bifrost gateway (default port 8081 — not 8080)
BIFROST_GATEWAY_URL=http://127.0.0.1:8081
BIFROST_API_KEY=
BIFROST_ENABLED=1
BIFROST_TIMEOUT_SEC=120
BIFROST_GATEWAY_PROBE_TIMEOUT_SEC=4
BIFROST_GATEWAY_CACHE_TTL_SEC=15

# Optional direct-provider keys (only used when BIFROST_ENABLED=0)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Sandbox
BIFROST_DOCKER_IMAGE=bifrost/sandbox:py3.11-slim
BIFROST_SANDBOX_MEMORY_MB=256
BIFROST_REQUIRE_DOCKER=1
BIFROST_ALLOW_HOST_SANDBOX=0

# Storage / HTTP
BIFROST_DB=./bifrost.db
BIFROST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
BIFROST_MAX_PARALLEL_RUNS=2
BIFROST_SIM_DELAY_MS=30
BIFROST_SEED_DEMO=0
