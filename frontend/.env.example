# Base URL of the Bifrost FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# "false" = live data from the backend (default). Set "true" only for offline demo/fixture mode.
VITE_USE_MOCK=false

# Dev-server proxy target (Vite dev only)
VITE_PROXY_TARGET=http://127.0.0.1:8000
